{
  "Environment": {
    "latitude": 39.3901806,
    "longitude": -8.289189,
    "elevation": 160,
    "max_expected_height": 4500,
    "_calls": [
      //
      // [ ISA ]: default, no set_atmospheric_model
      {
        "method": "set_date",
        "kwargs": {
          "date": [2025, 10, 13, 16]
        }
      }
      //
      // [ ENSEMBLE ]
      // ,{
      //   "method": "set_atmospheric_model",
      //   "kwargs": {
      //     "type": "Ensemble",
      //     "file": "[...].nc",
      //     "dictionary": {
      //       "ensemble": "number",
      //       "time": "valid_time",
      //       "latitude": "latitude",
      //       "longitude": "longitude",
      //       "level": "pressure_level",
      //       "temperature": "t",
      //       "surface_geopotential_height": null,
      //       "geopotential_height": null,
      //       "geopotential": "z",
      //       "u_wind": "u",
      //       "v_wind": "v"
      //     }
      //   }
      // }
      //
      //
      // [ WINDY / GFS FORECAST ]
      // ,{
      //   "method": "set_atmospheric_model",
      //   "kwargs": {
      //     "type": "Windy",
      //     "file": "GFS"
      //   }
      // },
      //
      //
      // [ CUSTOM ATMOSPHERE ]
      ,{
        "method": "set_atmospheric_model",
        "kwargs": {
          "type": "custom_atmosphere",
          "wind_u": [
            [0, 0],
            [4500, 0]
          ],
          "wind_v": [
            [0, 0],
            [4500, 0]
          ]
        }
      }
    ]
  },
  "SolidMotor": {
    "thrust_source": "Cesaroni_8187M1545_P.csv",
    "dry_mass": 0,
    "dry_inertia": [0, 0, 0],
    "nozzle_radius": 0.029,
    "grain_number": 6,
    "grain_density": 1758.7,
    "grain_outer_radius": 0.0359,
    "grain_initial_inner_radius": 0.0181,
    "grain_initial_height": 0.15617,
    "grain_separation": 0.003,
    "grains_center_of_mass_position": -0.7343,
    "center_of_dry_mass_position": 0,
    "nozzle_position": -1.296,
    "burn_time": 5.3,
    "throat_radius": 0.02,
    "coordinate_system_orientation": "nozzle_to_combustion_chamber"
  },
  "RocketV2": {
    "radius": 0.075,
    "mass": 22.74,
    "inertia": [14.304, 14.304, 0.078],
    "power_off_drag": "Nemesis150_v4.0_RAS_CDMACH_pwrOFF.csv",
    "power_on_drag": "Nemesis150_v4.0_RAS_CDMACH_pwrON.csv",
    "center_of_mass_without_motor": 0,
    "coordinate_system_orientation": "tail_to_nose"
  },
  "set_rail_buttons": {
    "upper_button_position": 0.98,
    "lower_button_position": -0.239,
    "angular_position": 0
  },
  "add_motor": {
    "position": 0
  },
  "add_nose": {
    "length": 0.45,
    "kind": "vonKarman",
    "position": 1.635
  },
  "add_trapezoidal_fins": {
    "n": 3,
    "root_chord": 0.3,
    "tip_chord": 0.093,
    "span": 0.16,
    "position": -0.855,
    "cant_angle": 0,
    "sweep_angle": 58
  },
  "add_tail": {
    "top_radius": 0.075,
    "bottom_radius": 0.046,
    "length": 0.116,
    "position": -1.155
  },
  "add_parachute": [
    {
      "name": "Main",
      "_trigger": "main",
      "_cd": 0.97,
      "_area": 10.5070863,
      "cd_s": "= $_cd * $_area",
      "lag": 1.73,
      "noise": [0, 6.5, 0.3]
    },
    {
      "name": "Drogue",
      "_trigger": "drogue",
      "_cd": 0.97,
      "_area": 0.6566929,
      "cd_s": "= $_cd * $_area",
      "lag": 1.73,
      "noise": [0, 6.5, 0.3]
    }
  ],
  "Flight": {
    "rail_length": 12,
    "inclination": 84,
    "heading": 144,
    "time_overshoot": false
  },
  "Sensors": {
    "_default_position": 0,

    "_profiles": {
      "clean": {
        // Ideal profile: no explicit noise/bias/resolution values.
        // Useful as a baseline and for HIL debugging.
        "Accelerometer": {
          "name": "Clean Accelerometer",
          "consider_gravity": true,
          "orientation": [0, 0, 0]
        },
        "Barometer": {
          "name": "Clean Barometer"
        },
        "GnssReceiver": {
          "name": "Clean GPS"
        }
      },

      "noisy": {
        "_inherits": "clean",

        "Accelerometer": {
          "name": "Noisy Accelerometer",

          // About ±16 g.
          "measurement_range": 160.0,

          // Quantization step in m/s².
          "resolution": 0.005,

          // RocketPy accelerometer noise units are m/s²/√Hz.
          "noise_density": 0.18,

          // Keep variance fixed across profiles; scale noise with noise_density.
          "noise_variance": 1.0,

          // Bias random walk in m/s²/√Hz.
          "random_walk_density": 0.02,
          "random_walk_variance": 1.0,

          // Constant additive acceleration bias in m/s².
          "constant_bias": 0.35,

          // Temperature values are in Kelvin, not Celsius.
          "operating_temperature": 298.15,

          // Temperature drift model: bias in m/s²/K, scale factor in %/K.
          "temperature_bias": 0.002,
          "temperature_scale_factor": 0.003,

          // RocketPy interprets this as percent. 0.3 means 0.3%.
          "cross_axis_sensitivity": 0.3
        },

        "Barometer": {
          "name": "Noisy Barometer",

          // Pressure range in Pa.
          "measurement_range": 200000,

          // Quantization step in Pa.
          "resolution": 0.1,

          // RocketPy barometer noise units are Pa/√Hz.
          "noise_density": 6.0,
          "noise_variance": 1.0,

          // Slow pressure drift in Pa/√Hz.
          "random_walk_density": 0.35,
          "random_walk_variance": 1.0,

          // Constant pressure bias in Pa.
          "constant_bias": 8.0,

          "operating_temperature": 298.15,

          // Temperature drift model: bias in Pa/K, scale factor in %/K.
          "temperature_bias": 0.08,
          "temperature_scale_factor": 0.003
        },

        "GnssReceiver": {
          "name": "Noisy GPS",

          // Standard deviation-like accuracy values in meters.
          "position_accuracy": 2.0,
          "altitude_accuracy": 3.0
        }
      },

      "very_noisy": {
        "_inherits": "noisy",

       "Accelerometer": {
        "name": "Very Noisy Accelerometer",
        "noise_density": 0.35,
        "random_walk_density": 0.05,
        "constant_bias": 0.75,

        // Slightly worse thermal and cross-axis behavior.
        "temperature_bias": 0.006,
        "cross_axis_sensitivity": 1.0
      },

        "Barometer": {
          "name": "Very Noisy Barometer",
          "noise_density": 25.0,
          "random_walk_density": 1.5,
          "constant_bias": 25.0
        },

        "GnssReceiver": {
          "name": "Very Noisy GPS",
          "position_accuracy": 4.0,
          "altitude_accuracy": 4.0
        }
      }
    }
  }
}
