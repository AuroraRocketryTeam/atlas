    ]
  },
  "SolidMotor": {
    "thrust_source": "SRAD_thrustcurve_BRICO_45_7mm.csv",
    "dry_mass": 0.7871568876139587,
    "dry_inertia": [0.66, 0.66, 1e-05],
    "nozzle_radius": 0.01371,
    "throat_radius": 0.0095,
    "grain_number": 1,
    "_grain_mass": 0.19694061309132402,
    "grain_outer_radius": 0.0165,
    "grain_initial_inner_radius": 0.0065,
    "grain_initial_height": 0.147,
    "grain_density": "= $SolidMotor._grain_mass / (pi * ($SolidMotor.grain_outer_radius^2 - $SolidMotor.grain_initial_inner_radius^2) * $SolidMotor.grain_initial_height)",
    "grain_separation": 0.003,
    "grains_center_of_mass_position": 0.125,
    "center_of_dry_mass_position": 0.09941,
    "nozzle_position": 0,
    "burn_time": 0.64,
    "coordinate_system_orientation": "nozzle_to_combustion_chamber"
  },
  "RocketV2": {
    "radius": 0.0425,
    "_dry_mass": 2.595,
    "_ballast": 0.0,
    "mass": "= $RocketV2._dry_mass + $RocketV2._ballast",
    "inertia": [1.49, 1.49, 0.01],
    "power_off_drag": "FRED_v2.0_CD_power_off.csv",
    "power_on_drag": "FRED_v2.0_CD_power_on.csv",
    "center_of_mass_without_motor": 0.373,
    "coordinate_system_orientation": "nose_to_tail"
  },
  "set_rail_buttons": {
    "upper_button_position": 0.424,
    "lower_button_position": 0.625,
    "angular_position": 0
  },
  "add_tail": {
    "top_radius": 0.0425,
    "bottom_radius": 0.03,
    "length": 0.043,
    "position": 0.81
  },
  "add_motor": {
    "position": "= $add_tail.position + $add_tail.length"
  },
  "add_nose": {
    "length": 0.14,
    "kind": "elliptical",
    "position": 0
  },
  "add_trapezoidal_fins": {
    "n": 3,
    "root_chord": 0.12,
    "tip_chord": 0.03,
    "span": 0.12,
    "position": 0.686,
    "cant_angle": 0,
    "sweep_angle": 30.3
  },
  "add_parachute": [
    {
      "name": "Main",
      "_trigger": "main",
      "_cd": 0.97,
      "_area": 1.168,
      "cd_s": "= $_cd * $_area",
      "_lag_se": 0.1,
      "_lag_rec": 2.0,
      "lag": "= $_lag_se + $_lag_rec",
      "noise": [0, 6.5, 0.3]
    }
  ],
  "Flight": {
    "rail_length": 2,
    "inclination": 75,
    "heading": 305,
    "time_overshoot": false
  },
  "Sensors": {
    "_default_position": 0,

    "_profiles": {
      "clean": {
        // Ideal profile: no explicit noise/bias/resolution values.
        // Useful as a baseline and for HIL debugging.
        "Accelerometer": {
          "name": "Clean Accelerometer",
          "consider_gravity": true,
          "orientation": [0, 0, 0]
        },
        "Barometer": {
          "name": "Clean Barometer"
        },
        "GnssReceiver": {
          "name": "Clean GPS"
        }
      },

      "noisy": {
        "_inherits": "clean",

        "Accelerometer": {
          "name": "Noisy Accelerometer",

          // About ±16 g.
          "measurement_range": 160.0,

          // Quantization step in m/s².
          "resolution": 0.005,

          // RocketPy accelerometer noise units are m/s²/√Hz.
          "noise_density": 0.18,

          // Keep variance fixed across profiles; scale noise with noise_density.
          "noise_variance": 1.0,

          // Bias random walk in m/s²/√Hz.
          "random_walk_density": 0.02,
          "random_walk_variance": 1.0,

          // Constant additive acceleration bias in m/s².
          "constant_bias": 0.35,

          // Temperature values are in Kelvin, not Celsius.
          "operating_temperature": 298.15,

          // Temperature drift model: bias in m/s²/K, scale factor in %/K.
          "temperature_bias": 0.002,
          "temperature_scale_factor": 0.003,

          // RocketPy interprets this as percent. 0.3 means 0.3%.
          "cross_axis_sensitivity": 0.3
        },

        "Barometer": {
          "name": "Noisy Barometer",

          // Pressure range in Pa.
          "measurement_range": 200000,

          // Quantization step in Pa.
          "resolution": 0.1,

          // RocketPy barometer noise units are Pa/√Hz.
          "noise_density": 6.0,
          "noise_variance": 1.0,

          // Slow pressure drift in Pa/√Hz.
          "random_walk_density": 0.35,
          "random_walk_variance": 1.0,

          // Constant pressure bias in Pa.
          "constant_bias": 8.0,

          "operating_temperature": 298.15,

          // Temperature drift model: bias in Pa/K, scale factor in %/K.
          "temperature_bias": 0.08,
          "temperature_scale_factor": 0.003
        },

        "GnssReceiver": {
          "name": "Noisy GPS",

          // Standard deviation-like accuracy values in meters.
          "position_accuracy": 2.0,
          "altitude_accuracy": 3.0
        }
      },

      "very_noisy": {
        "_inherits": "noisy",

       "Accelerometer": {
        "name": "Very Noisy Accelerometer",
        "noise_density": 0.35,
        "random_walk_density": 0.05,
        "constant_bias": 0.75,

        // Slightly worse thermal and cross-axis behavior.
        "temperature_bias": 0.006,
        "cross_axis_sensitivity": 1.0
      },

        "Barometer": {
          "name": "Very Noisy Barometer",
          "noise_density": 25.0,
          "random_walk_density": 1.5,
          "constant_bias": 25.0
        },

        "GnssReceiver": {
          "name": "Very Noisy GPS",
          "position_accuracy": 4.0,
          "altitude_accuracy": 4.0
        }
      }
    }
  }
}
