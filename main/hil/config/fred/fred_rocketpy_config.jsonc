{
  "Environment": {
    "latitude": 44.290583,
    "longitude": 12.027111,
    "elevation": 18,
    "max_expected_height": 200,
    "_calls": [
      //
      // [ LAUNCH DATE ]: set before loading a date-dependent atmosphere.
      {
        "method": "set_date",
        "kwargs": {
          // Exact launch time in Italy local time.
          "date": [2026, 10, 25, 14, 30],
          "timezone": "Europe/Rome"
        }
      }
      // [ ISA ]: default, no set_atmospheric_model
      //
      // [ ENSEMBLE ]
      // ,{
      //   "method": "set_atmospheric_model",
      //   "kwargs": {
      //     "type": "Ensemble",
      //     "file": "???.nc",
      //     "dictionary": {
      //       "ensemble": "number",
      //       "time": "valid_time",
      //       "latitude": "latitude",
      //       "longitude": "longitude",
      //       "level": "pressure_level",
      //       "temperature": "t",
      //       "surface_geopotential_height": null,
      //       "geopotential_height": null,
      //       "geopotential": "z",
      //       "u_wind": "u",
      //       "v_wind": "v"
      //     }
      //   }
      // }
      //
      //
      // [ GFS FORECAST ]
      ,{
        "method": "set_atmospheric_model",
        "kwargs": {
          "type": "Forecast",
          "file": "GFS"
        }
      }
      //
      //
      // [ CUSTOM ATMOSPHERE ]
      // ,{
      //   "method": "set_atmospheric_model",
      //   "kwargs": {
      //     "type": "custom_atmosphere",
      //     "_wind_magnitude_ground_m_s": 8.7,
      //     "_wind_heading_deg": 315,
      //     "_wind_u_ground": "= $_wind_magnitude_ground_m_s * sin(radians($_wind_heading_deg))",
      //     "_wind_v_ground": "= $_wind_magnitude_ground_m_s * cos(radians($_wind_heading_deg))",
      //     "wind_u": [
      //       [0,   "= 1.00 * $_wind_u_ground"],
      //       [50,  "= 1.05 * $_wind_u_ground"],
      //       [100, "= 1.10 * $_wind_u_ground"],
      //       [150, "= 1.15 * $_wind_u_ground"],
      //       [200, "= 1.20 * $_wind_u_ground"],
      //       [250, "= 1.25 * $_wind_u_ground"],
      //       [300, "= 1.30 * $_wind_u_ground"]
      //     ],
      //     "wind_v": [
      //       [0,   "= 1.00 * $_wind_v_ground"],
      //       [50,  "= 1.05 * $_wind_v_ground"],
      //       [100, "= 1.10 * $_wind_v_ground"],
      //       [150, "= 1.15 * $_wind_v_ground"],
      //       [200, "= 1.20 * $_wind_v_ground"],
      //       [250, "= 1.25 * $_wind_v_ground"],
      //       [300, "= 1.30 * $_wind_v_ground"]
      //     ]
      //   }
      // }
    ]
  },
  "SolidMotor": {
    "thrust_source": "TODO_CONFIRM_NEW_STATIC_FIRE_THRUST_CURVE",
    "dry_mass": 0.5808,
    "dry_inertia": [0.00455276, 0.00455276, 0.000222935],
    "nozzle_radius": 0.0089443, // Nozzle exit diameter 17.89 mm (expansion ratio 5); throat diameter 8 mm.
    "throat_radius": 0.004,
    "grain_number": 1,
    "grain_outer_radius": 0.0165,
    "grain_initial_inner_radius": 0.0065,
    "grain_initial_height": 0.147,
    "grain_density": 1853.75, // KNSB propellant with 1% Fe2O3.
    "grain_separation": 0.002,
    "grains_center_of_mass_position": 0.123459, // Grain center in a 0.2320 m long motor; positions run from nozzle to chamber.
    "center_of_dry_mass_position": 0.0873014,
    "nozzle_position": 0,
    "burn_time": "TODO_CONFIRM_NEW_STATIC_FIRE_BURN_TIME",
    "coordinate_system_orientation": "nozzle_to_combustion_chamber"
  },
  "RocketV2": {
    // FRED2.0 v1.0 geometry from OpenRocket FRED2.0-V1.0.ork via ork_positions.py.
    // Rocket positions run from nose tip toward tail; motor nozzle exit is at tail.
    "radius": 0.0425,
    "_dry_mass": 2.45,
    "_ballast": 0.0,
    "mass": "= $RocketV2._dry_mass + $RocketV2._ballast",
    "inertia": [0.159, 0.159, 0.003],
    "power_off_drag": "cd_mach.csv",
    "power_on_drag": "cd_mach.csv",
    "center_of_mass_without_motor": 0.439,
    "coordinate_system_orientation": "nose_to_tail"
  },
  "set_rail_buttons": {
    // Positions are button centers; the two centers are 0.23 m apart.
    "upper_button_position": 0.4315,
    "lower_button_position": 0.6615,
    "angular_position": 0
  },
  "add_tail": {
    // Conical tail in both the OpenRocket source and RocketPy.
    "top_radius": 0.0425,
    "bottom_radius": 0.03,
    "length": 0.043,
    "position": 0.8615
  },
  "add_motor": {
    // Tail end equals the CSV motor_position (0.9045 m): nozzle exit at rocket tail.
    "position": "= $add_tail.position + $add_tail.length"
  },
  "add_nose": {
    "length": 0.14,
    "kind": "elliptical",
    "position": 0
  },
  "add_trapezoidal_fins": {
    "n": 3,
    "root_chord": 0.12,
    "tip_chord": 0.03,
    "span": 0.12,
    // Start of the root chord, measured from the nose tip.
    "position": 0.7365,
    "sweep_angle": 45
  },
  "add_parachute": [
    {
      // Mission Analysis: one Rocketman 4 ft main, Cd 0.97, area 1.168 m^2,
      // no spill hole, intended to open at apogee. HIL follows the FC command.
      "name": "Main",
      "_trigger": "main",
      "_cd": 0.97,
      "_area": 1.168,
      "cd_s": "= $_cd * $_area",
      "lag": 1.5,
      // "noise": [0, 6.5, 0.3]
    }
  ],
  "Flight": {
    "rail_length": 1.5,
    "inclination": 70,
    "heading": 160,
    "time_overshoot": false
  },
  "Sensors": {
    "_default_position": 0,

    "_profiles": {
      "clean": {
        // Ideal profile: no explicit noise/bias/resolution values.
        // Useful as a baseline and for HIL debugging.
        "Accelerometer": {
          "name": "Clean Accelerometer",
          "consider_gravity": true,
          "orientation": [0, 0, 0]
        },
        "Barometer": {
          "name": "Clean Barometer"
        },
        "GnssReceiver": {
          "name": "Clean GPS"
        }
      },

      "noisy": {
        "_inherits": "clean",

        "Accelerometer": {
          "name": "Noisy Accelerometer",

          // About ±16 g.
          "measurement_range": 160.0,

          // Quantization step in m/s².
          "resolution": 0.005,

          // RocketPy accelerometer noise units are m/s²/√Hz.
          "noise_density": 0.18,

          // Keep variance fixed across profiles; scale noise with noise_density.
          "noise_variance": 1.0,

          // Bias random walk in m/s²/√Hz.
          "random_walk_density": 0.02,
          "random_walk_variance": 1.0,

          // Constant additive acceleration bias in m/s².
          "constant_bias": 0.35,

          // Temperature values are in Kelvin, not Celsius.
          "operating_temperature": 298.15,

          // Temperature drift model: bias in m/s²/K, scale factor in %/K.
          "temperature_bias": 0.002,
          "temperature_scale_factor": 0.003,

          // RocketPy interprets this as percent. 0.3 means 0.3%.
          "cross_axis_sensitivity": 0.3
        },

        "Barometer": {
          "name": "Noisy Barometer",

          // Pressure range in Pa.
          "measurement_range": 200000,

          // Quantization step in Pa.
          "resolution": 0.1,

          // RocketPy barometer noise units are Pa/√Hz.
          "noise_density": 6.0,
          "noise_variance": 1.0,

          // Slow pressure drift in Pa/√Hz.
          "random_walk_density": 0.35,
          "random_walk_variance": 1.0,

          // Constant pressure bias in Pa.
          "constant_bias": 8.0,

          "operating_temperature": 298.15,

          // Temperature drift model: bias in Pa/K, scale factor in %/K.
          "temperature_bias": 0.08,
          "temperature_scale_factor": 0.003
        },

        "GnssReceiver": {
          "name": "Noisy GPS",

          // Standard deviation-like accuracy values in meters.
          "position_accuracy": 2.0,
          "altitude_accuracy": 3.0
        }
      },

      "very_noisy": {
        "_inherits": "noisy",

       "Accelerometer": {
        "name": "Very Noisy Accelerometer",
        "noise_density": 0.35,
        "random_walk_density": 0.05,
        "constant_bias": 0.75,

        // Slightly worse thermal and cross-axis behavior.
        "temperature_bias": 0.006,
        "cross_axis_sensitivity": 1.0
      },

        "Barometer": {
          "name": "Very Noisy Barometer",
          "noise_density": 25.0,
          "random_walk_density": 1.5,
          "constant_bias": 25.0
        },

        "GnssReceiver": {
          "name": "Very Noisy GPS",
          "position_accuracy": 4.0,
          "altitude_accuracy": 4.0
        }
      }
    }
  }
}
