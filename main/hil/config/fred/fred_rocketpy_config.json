{
  "Environment": {
    "latitude": 44.290583,
    "longitude": 12.027111,
    "elevation": 18
  },

  "set_date": [2025, 5, 9, 12],
  "max_expected_height": 4500,

  "set_atmospheric_model": {
    "type": "Windy",
    "file": "GFS",
    "dictionary": {
      "ensemble": "number",
      "time": "valid_time",
      "latitude": "latitude",
      "longitude": "longitude",
      "level": "pressure_level",
      "temperature": "",
      "surface_geopotential_height": null,
      "geopotential_height": null,
      "geopotential": "z",
      "u_wind": "u",
      "v_wind": "v"
    }
  },

  "SolidMotor": {
    "thrust_source": "reshape_test_2026-05-21_21-07-43.csv",
    "dry_mass": 0.622,
    "dry_inertia": [0.66, 0.66, 0.00001],
    "nozzle_radius": 0.01371,
    "throat_radius": 0.0095,
    "grain_number": 1,

    "_grain_mass": 0.196,
    "grain_outer_radius": 0.0165,
    "grain_initial_inner_radius": 0.0065,
    "grain_initial_height": 0.147,
    "grain_density": "= $SolidMotor._grain_mass / (pi * ($SolidMotor.grain_outer_radius^2 - $SolidMotor.grain_initial_inner_radius^2) * $SolidMotor.grain_initial_height)",

    "grain_separation": 0.003,
    "grains_center_of_mass_position": 0.125,
    "center_of_dry_mass_position": 0.09941,
    "nozzle_position": 0,
    "burn_time": 2.30,
    "coordinate_system_orientation": "nozzle_to_combustion_chamber"
  },

  "RocketV2": {
    "radius": 0.0425,
    "_dry_mass": 2.201,
    "_ballast": 0.0,
    "mass": "= $RocketV2._dry_mass + $RocketV2._ballast",
    "inertia": [1.49, 1.49, 0.01],
    "power_off_drag": "CD_power_off_v2.3_TEST.csv",
    "power_on_drag": "CD_power_on_v2.3_TEST.csv",
    "center_of_mass_without_motor": 0.409,
    "coordinate_system_orientation": "nose_to_tail"
  },

  "set_rail_buttons": {
    "upper_button_position": 0.424,
    "lower_button_position": 0.625,
    "angular_position": 0
  },

  "add_tail": {
    "top_radius": 0.0425,
    "bottom_radius": 0.03,
    "length": 0.043,
    "position": 0.81
  },

  "add_motor": {
    "position": "= $add_tail.position + $add_tail.length"
  },

  "add_nose": {
    "length": 0.14,
    "kind": "elliptical",
    "position": 0
  },

  "add_trapezoidal_fins": {
    "n": 3,
    "root_chord": 0.12,
    "tip_chord": 0.03,
    "span": 0.12,
    "position": 0.686,
    "cant_angle": 0,
    "sweep_angle": 30.3
  },

  "add_parachute": [
    {
      "name": "Main",
      "_trigger": "main",
      "_cd": 0.97,
      "_area": 1.168,
      "cd_s": "= $_cd * $_area",
        "_lag_se": 1,
      "_lag_rec": 1,
      "lag": "= $_lag_se + $_lag_rec",
      "noise": [0, 6.5, 0.3]
    }
  ],

  "Flight": {
    "rail_length": 1.5,
    "inclination": 80,
    "heading": 160,
    "time_overshoot": false
  }
}
