# TODO: Can we remove the MCU choice? 

menu "Atlas Configuration"
    choice ATLAS_MCU
        bool "Target MCU"

        config ATLAS_MCU_ESP32S3_WROOM
            bool "ESP32-S3 WROOM"

        config ATLAS_MCU_ARDUINO_ESP32
            bool "Arduino Nano ESP32"
    endchoice

    choice COMPILE_BOARD
        prompt "Target Board"

        config COMPILE_BOARD_MANNY
            bool "Manny"
            help
                Manny flight computer board.
    endchoice
    config INSTALL_USB_JTAG_DRIVER
        bool "Install USB Serial/JTAG driver"
        default n
        help
            Set to false if no device is connected and able to consume JTAG I/O.

    config TELEMETRY_USB_MIRROR
        bool "Mirror telemetry over USB Serial/JTAG"
        default n
        help
            Feed the dashboard directly via USB without the ground station.
            python3 main.py --source serial --port /dev/cu.usbmodemXXX --baud 115200 --serial-format lora_binary
endmenu
